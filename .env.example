# ─── Core ────────────────────────────────────────────────────────────────────
# Postgres connection string.
# Production: use Coolify's SSL-enabled URL with `sslmode=verify-full` and mount
# its CA at /etc/ssl/certs/coolify-ca.crt. Set NODE_EXTRA_CA_CERTS to that path.
DATABASE_URL="postgres://sastra:sastra@localhost:5433/sastra"
# NODE_EXTRA_CA_CERTS="/etc/ssl/certs/coolify-ca.crt"
# Direct (unpooled) connection for migrations when DATABASE_URL goes through a
# transaction-mode pooler; defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=""
# Pool tuning. Hosted instances use a small pool and a short idle timeout so a
# scale-to-zero database can sleep. DB_PREPARE=false behind PgBouncer-style
# poolers (Neon "-pooler" hosts are detected automatically).
# DB_MAX_CONNECTIONS="10"
# DB_IDLE_TIMEOUT="120"
# DB_PREPARE="true"
# The container migrates and bootstraps before serving unless this is "false"
# (then a pre-deploy step runs scripts/migrate.mjs and bootstrap-workspace.mjs).
# MIGRATE_ON_START="true"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Exact app base URL. Drives auth callbacks, invite/magic links, email CTAs,
# and Origin/CORS checks. Get this exactly right in production.
BETTER_AUTH_URL="http://localhost:3243"
# Random secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-dev-secret-please-rotate"
# Separate HMAC secret for invite/bootstrap grants. Required in production.
# `openssl rand -base64 32`
AUTH_PROVISIONING_SECRET=""
# Disabled by default. For a brand-new empty database only, temporarily set this
# to "true" alongside the email/token below, create the first admin, then remove
# it or set it back to "false" and redeploy.
ENABLE_INITIAL_ADMIN_BOOTSTRAP="false"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_TOKEN=""
# One-time promotion for an existing active admin when no super admin exists.
# Set for one deployment, verify the role in Settings → Team, then remove it.
INITIAL_SUPER_ADMIN_EMAIL=""

# ─── Local browser-agent automation (development only) ───────────────────────
# Enables GET /api/dev/agent-login only under `next dev`. The proxy only
# allowlists this route in development, and the handler returns 404 outside dev
# or when any value below is missing. Use a random token:
#   openssl rand -base64 32
AGENT_BROWSER_DEV_TOKEN=""
AGENT_BROWSER_DEV_EMAIL=""
AGENT_BROWSER_DEV_PASSWORD=""

# ─── Email ───────────────────────────────────────────────────────────────────
# Notification and account email goes through one provider:
#   smtp   (default) any SMTP provider; Mailpit in dev (docker-compose)
#   resend Resend's HTTPS API — use where SMTP ports are blocked (Railway Hobby)
# EMAIL_PROVIDER is optional: a RESEND_API_KEY selects resend automatically.
# EMAIL_PROVIDER="smtp"
# RESEND_API_KEY=""
# Sender for notification and account email (falls back to SMTP_FROM).
# EMAIL_FROM="Sastra <notifications@mail.example.org>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sastra <noreply@sastra.example>"
# Correspondence address when it is NOT a Gmail mailbox (see the Gmail section):
# the address teammates CC/forward to and that quote requests, invoices, and
# replies are sent from through the provider above. It must be an address the
# provider is allowed to send as (a verified domain on Resend).
# CORRESPONDENCE_ADDRESS="office@mail.example.org"
# Inbound email without a Gmail mailbox: mail arrives by webhook instead of
# IMAP polling. Set ONE of these and point the sender at the matching route.
# Resend receiving: the Svix signing secret of the webhook that posts
#   `email.received` events to /api/email/inbound/resend (needs RESEND_API_KEY
#   so the original .eml can be downloaded).
# RESEND_WEBHOOK_SECRET="whsec_..."
# Generic relay: any script that can POST the raw .eml, signed with
#   X-Sastra-Timestamp + X-Sastra-Signature (HMAC-SHA256, see
#   lib/email/inbound-signature.ts), to /api/email/inbound.
# INBOUND_WEBHOOK_SECRET=""

# ─── Object storage (S3-compatible: Cloudflare R2 in prod, MinIO in dev) ──────
# Dev (docker-compose MinIO): ACCESS=minio SECRET=minio12345 BUCKET=sastra-files
#   ENDPOINT=http://localhost:9000  (console http://localhost:9001)
# Prod (R2): set ENDPOINT=https://<account>.r2.cloudflarestorage.com and configure
#   bucket CORS to allow PUT/GET from your app origin with the Content-Type header.
#   Add a lifecycle rule that deletes wiki-staging/ objects after 1 day as a
#   defense-in-depth cleanup for uploads abandoned before processing completes.
# Keep the bucket private and scope this token to this one bucket. Sastra's daily
# cleanup removes imported donation source files after the workspace retention
# period (30 days by default), so do not add a conflicting bucket lifecycle rule.
# Any S3-compatible service works (Railway Buckets, MinIO, AWS S3). The generic
# names S3_ENDPOINT / S3_BUCKET / S3_REGION / S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY are accepted as aliases; R2_* wins when both are set.
# Region defaults to "auto" (R2, MinIO); set it for services that need a real one.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
# R2_REGION="auto"

# ─── AI (OpenRouter) ─────────────────────────────────────────────────────────
# Used by the assistant, document AI, and semantic Wiki search/indexing.
# Optional: an admin can instead paste a key in Settings ▸ AI, which takes
# precedence over this value.
OPENROUTER_API_KEY=""
# Encrypts secrets stored in the database (the Settings ▸ AI key). Falls back
# to BETTER_AUTH_SECRET when unset; set it to keep stored secrets independent
# of session signing. Changing it makes already-stored secrets unreadable.
# APP_ENCRYPTION_KEY=""
# Production-only assistant project reads. Use the internal database URL for a
# grant-restricted SELECT-only role. In development/tests the assistant falls
# back to DATABASE_URL when this is blank; production deliberately does not.
ASSISTANT_DATABASE_RO_URL=""
# AI requests deny provider data collection and require Zero Data Retention by
# default. Only relax these after an explicit privacy review.
# OPENROUTER_ZDR="true"
# OPENROUTER_ALLOW_DATA_COLLECTION="false"

# ─── Fast typed pre-judgments (TypeSafe Jev) ─────────────────────────────────
# Optional. Cheap yes/no and pick-one judgments that decide whether a full AI
# call is needed at all (inbound email triage, assistant model routing). Leave
# blank to disable; the app then behaves exactly as it does without it. Also
# requires a super admin to turn on "Fast AI pre-checks" in Settings → AI.
TYPESAFEAI_API_KEY=""

# ─── Voice transcription (Cloudflare Workers AI Whisper) ─────────────────────
# Powers the assistant mic → speech-to-text. Uses the @cf/openai/whisper-large-v3-turbo
# model. CLOUDFLARE_ACCOUNT_ID falls back to R2_ACCOUNT_ID when left blank (same
# account). Create an API token scoped to "Workers AI" for the token below; leave
# the token blank to disable the mic button gracefully.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_WORKERS_AI_TOKEN=""

# ─── Google Drive (task attachments via the Drive Picker) ────────────────────
# Optional: when all four are set, teammates can connect their Google account and
# attach files from the shared drive to tasks. Login is unaffected when unset.
# 1) Google Cloud → OAuth client (Web) → CLIENT_ID/SECRET; redirect URI is
#    <BETTER_AUTH_URL>/api/auth/callback/google.  2) An API key restricted to the
#    Picker API, with the deployed app origin allowed as an HTTP referrer.
#    3) The shared drive id from its URL (/drive/folders/<id>).
# Uses the non-sensitive drive.file scope. For an External consent screen, set the
# app's publishing status to "In production" (no verification needed for drive.file)
# so tokens don't expire after 7 days.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PICKER_API_KEY=""
GOOGLE_SHARED_DRIVE_ID=""

# ─── Gmail correspondence hub (Rights / MoU email capture + send) ────────────
# Optional: when set, the app polls a shared mailbox over IMAP (people CC/BCC/
# forward it), links each thread to the project/publisher it concerns, and lets
# the assistant draft + send replies over SMTP. Unset = feature is off. No Google
# Cloud project or admin needed — just an app password on the mailbox.
#
# Setup (on the organization's shared mailbox, e.g. projects@example.org):
#  1. Turn ON 2-Step Verification, then create an App password (Google Account →
#     Security → App passwords). Put it in GMAIL_CAPTURE_APP_PASSWORD (spaces ok).
#  2. Enable IMAP: Gmail → Settings → Forwarding and POP/IMAP → Enable IMAP.
#  3. The cron tick (see CRON_SECRET below) polls it every 5 minutes during work
#     hours and hourly outside them; nothing else to schedule.
GMAIL_CAPTURE_MAILBOX=""
GMAIL_CAPTURE_APP_PASSWORD=""
# Host/port overrides (defaults are Gmail; only set for a non-Gmail IMAP/SMTP host):
# GMAIL_IMAP_HOST="imap.gmail.com"
# GMAIL_IMAP_PORT="993"
# GMAIL_SMTP_HOST="smtp.gmail.com"
# GMAIL_SMTP_PORT="465"

# ─── Cron (scheduled jobs: email, standups, indexing, blockers, cleanup) ──────
# Shared bearer secret protecting /api/cron/*. `openssl rand -base64 32`.
# Schedule ONE task: `POST /api/cron/tick` every minute with
# `Authorization: Bearer $CRON_SECRET`. The tick runs whichever jobs are due
# (see DEPLOY.md §5) and returns `nextDueAt`.
CRON_SECRET="change-me-dev-cron-secret"

# Receives the daily GitHub dependency-audit result. Generate independently
# with `openssl rand -base64 32`; use the same value for the GitHub Actions
# SECURITY_STATUS_WEBHOOK_SECRET repository secret. The daily security monitor
# also checks the live app-to-PostgreSQL connection for TLS.
SECURITY_STATUS_WEBHOOK_SECRET=""

# Optional: lets an assured super admin start the existing GitHub dependency
# workflow from Settings → Security. Use a fine-grained token scoped to this
# repository with Actions: write only; source-code write access is not needed.
# Published dependency-audit results. Every installation reads the entry for
# the version it runs from the public repository's daily audit; nothing to
# configure. Forks point this at their own feed; "off" disables the check.
# SECURITY_STATUS_URL="https://raw.githubusercontent.com/Sastra-Cloud/sastra/security-status/security-status.json"
# Optional: let super admins start the signed audit from Settings ▸ Security
# with a narrowly scoped GitHub Actions token (private deployments).
GITHUB_SECURITY_WORKFLOW_TOKEN=""
GITHUB_SECURITY_REPOSITORY="owner/repository"
# GITHUB_SECURITY_WORKFLOW_REF="main"

# ─── Bot protection (optional) ───────────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ─── Error monitoring (optional) ─────────────────────────────────────────────
# Set to capture server errors in Sentry. Unset = monitoring is a no-op.
# SENTRY_DSN=""

# ─── Web Push / PWA (optional) ───────────────────────────────────────────────
# Generate once: `npx web-push generate-vapid-keys`. Unset = push is a no-op
# (the PWA still installs; only push notifications are disabled).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""   # public key (safe to ship to the browser)
# VAPID_PRIVATE_KEY=""              # private key (server secret)
# VAPID_SUBJECT="mailto:notifications@yourdomain.com"  # contact URL, required by push services

# ─── Sastra Cloud (hosted instances only) ────────────────────────────────────
# Set by the control plane when it provisions a workspace. Leave unset when
# self-hosting: there is then no seat limit, no AI credit cap, and the
# /api/internal/management endpoints answer 404.
# Where the in-app "Source" link points (AGPL): defaults to the public
# repository. Forks set their own so the link shows the code actually running.
# SASTRA_SOURCE_REPOSITORY_URL="https://github.com/Sastra-Cloud/sastra"

# SASTRA_CLOUD_INSTANCE_ID=""
# SASTRA_CLOUD_MANAGEMENT_SECRET=""   # HMAC secret for signed management calls
# SASTRA_CLOUD_ACCOUNT_URL=""         # where customers manage their plan
