# ── Sastra Compose bundle ─────────────────────────────────────────────────────
# Copy to .env next to docker-compose.yml. Generate secrets with:
#   openssl rand -base64 32

SASTRA_TAG=0.2.0               # pin the application release
SASTRA_PORT=3000               # host port; put a reverse proxy with HTTPS in front

# Database: the default Compose bundle runs Postgres locally with this password.
POSTGRES_PASSWORD=
# For docker-compose.neon.yml, leave POSTGRES_PASSWORD blank and uncomment
# these two URLs from Neon Connect. Use sslmode=verify-full in both URLs.
# DATABASE_URL=""             # pooled URL (hostname contains -pooler)
# DATABASE_MIGRATION_URL=""   # direct URL for the same database
# DB_MAX_CONNECTIONS=3

# The exact public URL people open, e.g. https://planner.example.org
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Signs first-admin setup and invitation grants; required in production.
AUTH_PROVISIONING_SECRET=
CRON_SECRET=
# Encrypts secrets stored in the database (the Settings ▸ AI key)
APP_ENCRYPTION_KEY=

# Email (required: sign-in links, invitations, notifications).
# Either Resend...
# RESEND_API_KEY=
# EMAIL_FROM="Sastra <noreply@example.org>"
# ...or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sastra <noreply@example.org>"

# Files: any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO ...).
# With the bundled MinIO (`docker compose --profile minio up -d`):
#   R2_ENDPOINT=http://minio:9000  R2_ACCESS_KEY_ID=sastra  R2_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
R2_ENDPOINT=
R2_BUCKET=sastra-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# MINIO_ROOT_USER=sastra
# MINIO_ROOT_PASSWORD=

# AI (optional; can also be pasted in Settings ▸ AI).
# Without a key, the assistant, AI planning, extraction, drafting and summaries
# are unavailable. Manual planning and tracking still work.
OPENROUTER_API_KEY=

# First admin: set all three for the very first start. /login then shows
# "Create the first admin" for INITIAL_ADMIN_EMAIL, who types the token.
# Once the account exists, set ENABLE_INITIAL_ADMIN_BOOTSTRAP=false again.
ENABLE_INITIAL_ADMIN_BOOTSTRAP=true
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_TOKEN=

# Optional: correspondence capture, push notifications, error monitoring.
# See docs/self-hosting/README.md for the full list.

# Optional: push notifications for the installed app (phones and desktops).
# Generate a key pair once with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.org
