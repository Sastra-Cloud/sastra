    "agent-browser": "node scripts/agent-browser-dev.mjs",
    "agent-browser:install": "node scripts/agent-browser-dev.mjs install",
    "agent-browser:open": "node scripts/agent-browser-dev.mjs open",
    "agent-browser:snapshot": "node scripts/agent-browser-dev.mjs snapshot",
    "agent-browser:screenshot": "node scripts/agent-browser-dev.mjs screenshot",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "node scripts/database-preflight.mjs && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "podcast:backfill": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-podcast-workflows.ts",
    "auth:generate": "better-auth generate",
    "db:check": "node scripts/database-preflight.mjs",
    "db:smoke": "node scripts/database-smoke.mjs",
    "typecheck:tsrs": "pnpm typecheck",
    "typecheck:tsc": "tsc --noEmit"
