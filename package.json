    "type": "git",
    "url": "https://github.com/Sastra-Cloud/sastra.git"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/database-preflight.mjs --next-env=development && next dev -p 3243",
    "build": "node scripts/build.mjs",
    "start": "node scripts/database-preflight.mjs --next-env=production && next start",
    "lint": "eslint",
    "typecheck": "tsrs --noEmit --tsBuildInfoFile tsconfig.tsrs.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval-print-extraction.ts",
    "eval:assistant": "tsx scripts/eval-assistant.ts",
    "eval:jev": "tsx scripts/eval-jev-email-tasks.ts",
